# 이 파일을 .env 로 복사해 채운다. .env 는 커밋하지 않는다.

# 노션 인테그레이션 토큰. 공유페이지·기업·프로젝트·공지 DB 에 연결돼 있어야 한다.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 빌드가 공지를 가져갈 때 중계 서버에 대는 값. 공지의 원본이 노션에서
# 중계 서버의 저장소로 옮겨 왔다 (docs/adr/0004-공지-원본-이사.md).
# 담당자 공용 비밀번호와 다른 값이고, 읽기만 된다.
# 없으면 경고를 남기고 공지를 노션에서 읽는다 — 담당자가 페이지에서 고친
# 공지는 그때 나가지 않는다.
BUILD_TOKEN=

# (선택) 중계 서버 주소. 비워 두면 배포본을 쓴다. 로컬 워커로 시험할 때만 채운다.
RELAY_URL=

# (선택) 일정의 세 번째 원천. 비워 두면 조용히 건너뛴다.
CALENDAR_ICS_URL=

# 다우오피스 IMAP 접속 정보 (993/SSL 고정).
# check_imap.py 점검과 소통 내역 수집에 함께 쓴다.
IMAP_HOST=imap.example.com
IMAP_USER=me@example.com
IMAP_PASS=

# (선택) 우리 쪽 사람이 쓰는 개인 메일 주소. 쉼표로 여러 개.
# 고객사 폴더에 이 주소로 전달된 메일이 있어도 「상대방」으로 보지 않는다 —
# 보낸메일함에서 남의 클라이언트 건이 딸려 오는 것을 막는다.
# IMAP_USER 는 자동으로 포함되므로 적지 않아도 된다.
OWN_MAIL_EXTRA=

# (선택) 구글 서비스 계정 키 경로.
# 키 파일은 반드시 레포 밖에 둔다 — 레포 루트는 통째로 웹에 서빙된다.
GOOGLE_APPLICATION_CREDENTIALS=C:\경로\밖\google-key.json

# (선택) 녹음 전사 — src/transcribe_drive.py 가 쓴다.
# GEMINI_API_KEY 가 없으면 전사만 건너뛰고 나머지 자동화는 그대로 돈다.
GEMINI_API_KEY=

# 구글 드라이브 「클라이언트 통화 미팅기록」 폴더 경로.
# 비워 두면 G:\.shortcut-targets-by-id\... 기본값을 쓴다.
# 드라이브 문자가 다른 PC 에서만 채운다.
TALKS_DIR=

# (선택) 전사 모델. 비워 두면 코드의 기본값을 쓴다.
GEMINI_MODEL=
