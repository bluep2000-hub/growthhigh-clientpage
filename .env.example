# 이 파일을 .env 로 복사해 채운다. .env 는 커밋하지 않는다.

# 노션 인테그레이션 토큰. 공유페이지·기업·프로젝트·공지 DB 에 연결돼 있어야 한다.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (선택) 일정의 세 번째 원천. 비워 두면 조용히 건너뛴다.
CALENDAR_ICS_URL=

# src/check_imap.py 전용. 다우오피스 IMAP 접속 정보 (993/SSL 고정).
IMAP_HOST=imap.example.com
IMAP_USER=me@example.com
IMAP_PASS=
